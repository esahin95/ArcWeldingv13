FoamFile
{
    format      binary;
    class       volScalarField;
    location    "0";
    object      T.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    ymax
    {
        type            fixedValue;
        value           uniform 300;
    }
    xmin
    {
        type            fixedValue;
        value           uniform 300;
    }
    xmax
    {
        type            fixedValue;
        value           uniform 300;
    }
    ymin
    {
        type            fixedValue;
        value           uniform 300;
    }
    zmin
    {
        type            fixedValue;
        value           uniform 300;
    }
    zmax
    {
        type            inletOutlet;
        inletValue      uniform 300;
        value           uniform 300;
    }
}


// ************************************************************************* //
