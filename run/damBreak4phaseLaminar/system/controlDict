FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          icoMulticomponentVoF;
//solver          compressibleMultiphaseVoF;

startFrom       startTime;

startTime       0;

stopAt          endTime;
//stopAt          nextWrite;

endTime         1;

deltaT          0.001;

writeControl    adjustableRunTime;
//writeControl    timeStep;

writeInterval   0.05;
//writeInterval   10;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;
//adjustTimeStep  no;

maxCo           0.5;
maxAlphaCo      0.5;

maxDeltaT       1;

// ************************************************************************* //

OptimisationSwitches
{
    fileHandler collated;
}

functions
{
    #includeFunc cellMax;
    #includeFunc cellMin;
}