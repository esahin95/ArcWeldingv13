FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          icoPhaseChangeVoF;

startFrom       startTime;

startTime       0;

stopAt          endTime;
//stopAt          nextWrite;

endTime         0.05;

deltaT          1e-5;

writeControl    adjustableRunTime;

writeInterval   0.005;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.2;
maxAlphaCo      0.2;
maxDiCo         100;

maxDeltaT       1;

// ************************************************************************* //

DebugSwitches
{
    MULES           1;
    BoussinesqForce 1;
}

OptimisationSwitches
{
    fileHandler collated;
}

writeFO     timeStep;
writeFO     writeTime;

functions
{
    /*
    vCellProc
    {
        type            volField;
        libs            ("libfieldFunctionObjects.so");
        log             true;
        writeControl    writeTime;
        writeFields     true;
        field           cellProc;
    }
    */

    maxValue
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        log             true;
        writeControl    $writeFO;
        writeFields     false;
        regionType      all;
        cellZone        all;
        operation       max;
        fields (p_rgh T alphaHeat.water heat.water);
    }

    minValue
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        log             true;
        writeControl    $writeFO;
        writeFields     false;
        regionType      all;
        cellZone        all;
        operation       min;
        fields (p_rgh T alphaHeat.water heat.water);
    }

    maxMagValue
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        log             true;
        writeControl    $writeFO;
        writeFields     false;
        regionType      all;
        cellZone        all;
        operation       maxMag;
        fields (U);
    }

    volIntHeat
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        log             true;
        writeControl    writeTime;
        writeFields     false;
        regionType      all;
        cellZone        all;
        operation       volIntegrate;
        fields (alphaHeat.water);
    }

    bubble
    {
        type            phaseScalarTransport;
        libs            ("libsolverFunctionObjects.so");
        field           heat.water;
        schemesField    alpha.water;
        p               p;
        alpha           alpha.water;
        alphaPhi        alphaRhoPhi.water;
        diffusivity     constant;
        D               1.4285e-6;
        writeControl    writeTime;
    }

}