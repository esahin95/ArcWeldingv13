     \\/     M anipulation  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "(bottom|right)"
    {
        type            zeroGradient;
    }

    top
    {
        type            fixedValue;
        value           uniform 0;
    }

    left
    {
        type            codedFixedValue;
        value           uniform 200;
        name            leftTemperature;

        code
        #{
            const vectorField& Cf = patch().Cf();
            forAll(Cf, faceI)
            {
                operator[](faceI) = 1.0 - Cf[faceI].y();
            }
        #};
    }

    "(front|back)"
    {
        type            empty;
    }
}


// ************************************************************************* //