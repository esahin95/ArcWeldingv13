FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     checkMatrix;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1;

deltaT          1;

writeControl    timeStep;

writeInterval   1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  no;


// ************************************************************************* //

DebugSwitches
{
    MULES           1;
}

OptimisationSwitches
{
    fileHandler collated;
}

functions
{
    divU
    {
        type            div;
        libs            ("libfieldFunctionObjects.so");

        writeControl    writeTime;
        writeFields     false;
        regionType      all;

        result          divU;

        field           phi;
    }

    maxValue
    {
        type            volFieldValue;

        libs            ("libfieldFunctionObjects.so");

        log             true;

        writeControl    timeStep;

        writeFields     false;

        regionType      all;

        cellZone        all;

        operation       max;

        fields (p_rgh T divU);
    }

    minValue
    {
        type            volFieldValue;

        libs            ("libfieldFunctionObjects.so");

        log             true;

        writeControl    timeStep;

        writeFields     false;

        regionType      all;

        cellZone        all;

        operation       min;

        fields (p_rgh T divU);
    }

    maxMagValue
    {
        type            volFieldValue;

        libs            ("libfieldFunctionObjects.so");

        log             true;

        writeControl    timeStep;

        writeFields     false;

        regionType      all;

        cellZone        all;

        operation       maxMag;

        fields (U);
    }

    lineUniform
    {
        type            sets;

        libs            ("libsampling.so");

        writeControl    writeTime;

        interpolationScheme cellPoint;

        setFormat       raw;

        fields          (alpha.water);

        sets
        (
            left
            {
                type            lineUniform;
                axis            distance;
                start           (1e-7 0.0 5e-5);
                end             (1e-7 5e-4 5e-5);
                nPoints         120;
            }

            right
            {
                type            lineUniform;
                axis            distance;
                start           (0.9999e-3 0.0 5e-5);
                end             (0.9999e-3 5e-4 5e-5);
                nPoints         120;
            }
        );
    }
}