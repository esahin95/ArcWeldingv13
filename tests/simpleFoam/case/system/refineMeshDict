FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      refineMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

coordinates
{
    type        global;

    e1          (1 0 0);
    e2          (0 1 0);

    directions  (e1 e2);
}

zones
{
    lCorner
    {
        type    sphere;

        radius 0.3;
        centre (0 0 0);
    }

    rCorner
    {
        type    sphere;

        radius 0.3;
        centre (1 1 0);
    }
}

